{
  "release": {
    "tag": "v{version}",
    "legacyTags": [
      "v"
    ],
    "green": "forge-checks",
    "images": [
      {
        "name": "mudflaps",
        "dockerfile": "Dockerfile",
        "args": {
          "VERSION": "{version}"
        },
        "labels": {
          "org.opencontainers.image.source": "https://github.com/intentius/mudflaps",
          "org.opencontainers.image.version": "{version}",
          "org.opencontainers.image.licenses": "MIT"
        }
      }
    ],
    "artifacts": [
      {
        "name": "goreleaser",
        "goreleaser": {}
      }
    ],
    "publish": [
      {
        "type": "forge",
        "forge": "github",
        "repo": "INTENTIUS/mudflaps",
        "assets": [
          "artifact:goreleaser"
        ],
        "notes": {
          "generate": "commits",
          "exclude": [
            "docs",
            "test",
            "chore"
          ]
        }
      },
      {
        "type": "oci",
        "image": "build/images/mudflaps.tar",
        "repository": "ghcr.io/intentius/mudflaps",
        "tags": [
          "{label}",
          "latest"
        ],
        "platformTags": [
          "{version}-{arch}"
        ]
      }
    ],
    "workflow": {
      "trigger": "dispatch",
      "file": ".github/workflows/release.yml"
    }
  }
}
